# copy to .env and fill in (don't commit .env)

# AssemblyAI
ASSEMBLYAI_API_KEY=
VOICE_AGENT_VOICE=michael
ASSEMBLYAI_WS_URL=wss://agents.assemblyai.com/v1/ws
# for the fake agent: ASSEMBLYAI_WS_URL=ws://localhost:8765

# scoring: "mock" or "anthropic"
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# sqlite locally, postgres url in production
DATABASE_URL=sqlite:///./interview.db

MAX_INTERVIEW_SECONDS=1500

# password for the HR pages (X-HR-Key header). empty = no check
HR_API_KEY=
