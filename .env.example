# Copy to .env and fill in. Never commit .env.

# AssemblyAI Voice Agent
ASSEMBLYAI_API_KEY=
VOICE_AGENT_VOICE=michael
# Point at the local fake agent to develop without credits:
# ASSEMBLYAI_WS_URL=ws://localhost:8765
ASSEMBLYAI_WS_URL=wss://agents.assemblyai.com/v1/ws

# Transcript scoring: "mock" (no key, placeholder scores) or "anthropic"
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# SQLite locally. Use a hosted Postgres URL in production.
DATABASE_URL=sqlite:///./interview.db

# Hard cap on one interview, in seconds
MAX_INTERVIEW_SECONDS=1500
